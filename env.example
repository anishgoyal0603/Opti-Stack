GEMINI_API_KEY=your-api-key-here
# Optional: comma-separated model fallback chain, highest priority first.
# Overrides the built-in default without a code change.
# OPTISTACK_MODELS=gemini-3.5-flash,gemini-3.1-pro-preview

# Set to 1 to enable free-text arbitrary code submission (local/cloned use
# only). Unset, empty, or any other value defaults to the safe examples-only
# mode, which is what any public deployment should use.
# OPTISTACK_ALLOW_ARBITRARY_CODE=1
